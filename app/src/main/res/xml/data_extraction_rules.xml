<?xml version="1.0" encoding="utf-8"?>
<!-- API keys stay on this phone: their Keystore key can't be restored elsewhere anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="voicebar_secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="voicebar_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
